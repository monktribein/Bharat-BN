# ==========================================
# BharatBN™ Backend Environment Configuration
# ==========================================

# Server Port & Environment
PORT=4000
NODE_ENV=development

# Allowed Origins for CORS (Frontend & Admin Console)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Optional: comma-separated list of additional origins (e.g. production domains)
# ALLOWED_ORIGINS=https://bharatbn.com,https://admin.bharatbn.com

# Database (Supabase / PostgreSQL)
# Required when connecting to persistent cloud database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Queue & Cache (Redis / BullMQ)
# Required for background jobs (SEO milestones, cralwer queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (for Admin / Business authentication sessions)
JWT_SECRET=super-secret-bharatbn-key-change-in-production
